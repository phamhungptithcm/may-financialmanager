# Mây Family Finance — Environment Configuration Template
# Copy this file to .env.dev, .env.staging, or .env.prod and fill in real values.
# NEVER commit real secrets. Use GitHub Secrets + Secret Manager in production.

# -- Firebase Project ID (not a secret, but environment-specific) --
MAY_PROJECT_ID=may-dev
# MAY_PROJECT_ID=may-staging  (for staging)
# MAY_PROJECT_ID=may-prod     (for production)

# -- Build Flavor / Profile (no secrets) --
MAY_FLAVOR=development
MAY_ENVIRONMENT=dev

# -- Flutter Runtime Flags (passed via dart-define) --
# These are injected at build time, not read from this file directly.
# See: apps/mobile/android/app/build.gradle for how they're wired in.

# -- Secret Manager Keys (DO NOT put real values here) --
# Real secrets live in:
#   - Google Cloud Secret Manager: https://console.cloud.google.com/cloud/secret-manager
#   - GitHub Secrets (for CI): Settings → Secrets and variables → Actions
#
# Required secrets per environment:
#
# MAY_FIREBASE_CONFIG_STAGING  (base64-encoded firebase-config.json for staging)
# MAY_FIREBASE_CONFIG_PROD     (base64-encoded firebase-config.json for production)
# MAY_APPLE_SERVICE_KEY_ID     (App Store Connect API key ID)
# MAY_APPLE_SERVICE_KEY_P8     (App Store Connect .p8 private key, base64-encoded)
# MAY_APPLE_SERVICE_ISSUER_ID  (App Store Connect issuer UUID)
# MAY_GOOGLE_PLAY_SERVICE_KEY  (Google Play Service Account JSON, base64-encoded)
# MAY_FIREBASE_SERVICE_ACCOUNT (Firebase Admin SDK service account JSON for prod)
#
# Set them via GitHub Environments:
#   Settings → Environments → may-staging / may-prod → Environment secrets

# -- Store Product IDs (non-secret, environment-specific) --
MAY_APPLE_PRODUCT_ID_MONTHLY=may.plus.monthly
MAY_APPLE_PRODUCT_ID_YEARLY=may.plus.yearly
MAY_GOOGLE_PRODUCT_ID_MONTHLY=may_plus_monthly
MAY_GOOGLE_PRODUCT_ID_YEARLY=may_plus_yearly

# -- AdMob (non-secret) --
MAY_ADMOB_APP_ID=ca-app-p-your-app-id~your-test-id  # Replace with real ID per env

# -- Firebase Region (non-secret) --
MAY_FIREBASE_REGION=asia-east1
