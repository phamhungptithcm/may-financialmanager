{
  "database": {
    "rules": "firebase/database.rules.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    }
  ],
  "emulators": {
    "auth": {"port": 9099},
    "database": {"port": 9000},
    "functions": {"port": 5001},
    "storage": {"port": 9199},
    "ui": {"enabled": true}
  }
}
