      ".write": false
    },
    "invites": {
      ".read": false,
      ".write": false
    },
    "bills": {
      "$hid": {
        ".read": "auth != null && root.child('members').child($hid).child(auth.uid).child('status').val() === 'ACTIVE'"
      }
    },
    "ownershipTransferRequests": {
      ".read": false,
      ".write": false
    }
  }
