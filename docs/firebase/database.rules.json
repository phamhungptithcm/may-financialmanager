{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "userHouseholds": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "households": {
      "$hid": {
        ".read": "auth != null && root.child('members').child($hid).child(auth.uid).child('status').val() === 'ACTIVE'"
      }
    },
    "members": {
      "$hid": {
        ".read": "auth != null && root.child('members').child($hid).child(auth.uid).child('status').val() === 'ACTIVE'"
      }
    },
    "accounts": {
      "$hid": {
        ".read": "auth != null && root.child('members').child($hid).child(auth.uid).child('status').val() === 'ACTIVE'"
      }
    },
    "categories": {
      "$hid": {
        ".read": "auth != null && root.child('members').child($hid).child(auth.uid).child('status').val() === 'ACTIVE'"
      }
    },
    "budgets": {
      "$hid": {
        ".read": "auth != null && root.child('members').child($hid).child(auth.uid).child('status').val() === 'ACTIVE'"
      }
    },
    "budgetStatus": {
