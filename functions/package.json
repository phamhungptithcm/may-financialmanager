{
  "name": "may-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Mây Family Finance — Firebase Cloud Functions v2",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "emulators": "firebase emulators:exec --only functions,auth,database,storage \"npm test\"",
    "serve": "firebase emulators:start --only functions,auth,database,storage",
    "deploy:functions": "firebase deploy --only functions",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "firebase-functions-test": "^3.3.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
